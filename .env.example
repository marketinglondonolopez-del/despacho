# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - SISTEMA DE DESPACHO INTELIGENTE
# ==============================================================================

# Entorno: development | production | test
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos PostgreSQL
# En producción: postgresql://usuario:password@host:5432/dispatch_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dispatch_db?schema=public"

# Redis (Caché, Distribución de Bloqueos Atómicos y Colas)
REDIS_URL="redis://localhost:6379"

# Meta WhatsApp Business Cloud API Oficial
# Obtenidos en https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_here"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_permanent_token_here"
WHATSAPP_VERIFY_TOKEN="super_secret_webhook_verify_token_custom_value"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_hmac_sha256_verification"
WHATSAPP_API_VERSION="v20.0"

# Mapas y Geolocalización (Google Maps o Mapbox)
MAPS_PROVIDER=google # "google" o "mapbox"
MAPS_API_KEY="your_google_maps_or_mapbox_api_key_here"

# Seguridad y Autenticación JWT
JWT_SECRET="generate_a_very_long_secure_random_string_at_least_64_chars_here"
JWT_EXPIRES_IN="7d"

# Parámetros del Motor de Despacho (Defaults configurables en base de datos)
DEFAULT_ROUND_1_DRIVERS=3
DEFAULT_ROUND_1_TIMEOUT_SEC=15
DEFAULT_ROUND_2_DRIVERS=5
DEFAULT_ROUND_2_TIMEOUT_SEC=20
DEFAULT_MAX_SEARCH_RADIUS_KM=8.0
GPS_STALE_THRESHOLD_SECONDS=45
MIN_REVIEWS_FOR_STABLE_REPUTATION=50
